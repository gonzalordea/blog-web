# Copia este archivo a ".env" (en la misma carpeta) y ajusta los valores.
# ".env" nunca se sube a git (está en .gitignore) — solo vive en tu ordenador
# o en las variables de entorno del servidor donde despliegues la app.

# Ruta del archivo de base de datos SQLite.
# Por defecto: database/blog.db
DB_PATH=database/blog.db

# Carpeta donde se guardan las imágenes subidas desde el panel admin.
# Por defecto: public/uploads
# En Railway (o cualquier plataforma con sistema de archivos efímero),
# apúntala DENTRO de tu volumen persistente, junto a la base de datos
# (por ejemplo: /app/data/uploads), o las imágenes desaparecerán en cada
# redeploy.
UPLOADS_DIR=public/uploads

# Credenciales del usuario administrador (panel /admin).
ADMIN_EMAIL=admin@blog.com
ADMIN_PASSWORD=admin123

# Frase secreta para firmar las cookies de sesión. Ponle algo largo y
# aleatorio, sobre todo en producción — puedes generar una con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=cambia-esto-por-una-frase-secreta-larga

# Puerto en el que arranca el servidor (opcional).
PORT=3000
