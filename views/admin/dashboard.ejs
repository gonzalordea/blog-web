<%- include('../partials/header', { metaTitulo: "Panel de administración — Código al Día", metaNoIndex: true }) %>

<section class="dashboard">
  <div class="dashboard-cabecera">
    <h1>Panel de administración</h1>
    <div>
      <a href="/admin/comentarios" class="boton boton-secundario">Comentarios</a>
      <a href="/admin/categorias" class="boton boton-secundario">Categorías</a>
      <a href="/admin/posts/nuevo" class="boton">+ Nuevo artículo</a>
    </div>
  </div>

  <% if (posts.length === 0) { %>
    <p class="vacio">No hay artículos todavía. Crea el primero.</p>
  <% } else { %>
    <div class="stats-resumen">
      <div class="stat-tarjeta">
        <p class="stat-numero"><%= resumen.totalVisitas %></p>
        <p class="stat-etiqueta">Visitas totales</p>
      </div>
      <div class="stat-tarjeta">
        <p class="stat-numero"><%= resumen.publicados %></p>
        <p class="stat-etiqueta">Publicados</p>
      </div>
      <div class="stat-tarjeta">
        <p class="stat-numero"><%= resumen.borradores %></p>
        <p class="stat-etiqueta">Borradores</p>
      </div>
      <% if (resumen.masVisitado && resumen.masVisitado.visitas > 0) { %>
        <div class="stat-tarjeta stat-tarjeta--ancha">
          <p class="stat-etiqueta">Artículo más visitado</p>
          <p class="stat-destacado"><%= resumen.masVisitado.titulo %> (<%= resumen.masVisitado.visitas %>)</p>
        </div>
      <% } %>
    </div>
  <% } %>

  <table class="tabla-admin">
    <thead>
      <tr>
        <th>Título</th>
        <th>Estado</th>
        <th>Categoría</th>
        <th>Visitas</th>
        <th>Fecha</th>
        <th>Acciones</th>
      </tr>
    </thead>
    <tbody>
      <% posts.forEach(function(post) { %>
        <tr>
          <td>
            <%= post.titulo %>
            <% if (post.destacado) { %>
              <span class="etiqueta-destacado">Destacado</span>
            <% } %>
          </td>
          <td>
            <span class="etiqueta-estado etiqueta-estado--<%= post.estado %>">
              <%= post.estado === "publicado" ? "Publicado" : "Borrador" %>
            </span>
          </td>
          <td><%= post.categoria_nombre || "—" %></td>
          <td class="celda-visitas"><%= post.visitas %></td>
          <td><%= post.fecha_creacion %></td>
          <td class="acciones">
            <a href="/post/<%= post.slug %>" target="_blank">Ver</a>
            <a href="/admin/posts/<%= post.id %>/editar">Editar</a>
            <form action="/admin/posts/<%= post.id %>/estado" method="POST" class="form-estado">
              <button type="submit"><%= post.estado === "publicado" ? "Pasar a borrador" : "Publicar" %></button>
            </form>
            <form action="/admin/posts/<%= post.id %>/destacar" method="POST" class="form-destacar">
              <button type="submit"><%= post.destacado ? "Quitar destacado" : "Destacar" %></button>
            </form>
            <form action="/admin/posts/<%= post.id %>/borrar" method="POST" class="form-borrar" onsubmit="return confirm('¿Seguro que quieres borrar este artículo?');">
              <button type="submit">Borrar</button>
            </form>
          </td>
        </tr>
      <% }); %>
    </tbody>
  </table>
</section>

<%- include('../partials/footer') %>
