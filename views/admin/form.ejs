<%- include('../partials/header', { metaTitulo: (post ? "Editar artículo" : "Nuevo artículo") + " — Blog Dev", metaNoIndex: true }) %>

<section class="form-caja">
  <h1><%= post ? "Editar artículo" : "Nuevo artículo" %></h1>

  <% if (typeof error !== "undefined" && error) { %>
    <p class="mensaje-error"><%= error %></p>
  <% } %>

  <form action="<%= post ? '/admin/posts/' + post.id + '/editar' : '/admin/posts/nuevo' %>" method="POST" enctype="multipart/form-data" class="formulario">
    <label for="titulo">Título</label>
    <input type="text" id="titulo" name="titulo" required value="<%= post ? post.titulo : '' %>" />

    <label for="resumen">Resumen (aparece en la portada)</label>
    <textarea id="resumen" name="resumen" rows="2" required><%= post ? post.resumen : '' %></textarea>

    <label for="categoria_id">Categoría</label>
    <select id="categoria_id" name="categoria_id">
      <option value="">Sin categoría</option>
      <% categorias.forEach(function(categoria) { %>
        <option value="<%= categoria.id %>" <%= post && post.categoria_id === categoria.id ? 'selected' : '' %>>
          <%= categoria.nombre %>
        </option>
      <% }); %>
    </select>

    <label for="imagen">Imagen del artículo (opcional, JPG/PNG/WEBP/GIF, máx. 5 MB)</label>
    <% if (post && post.imagen) { %>
      <img src="<%= post.imagen %>" alt="Imagen actual" class="form-imagen-actual" />
      <p class="form-imagen-nota">Sube un archivo solo si quieres reemplazar esta imagen.</p>
    <% } %>
    <input type="file" id="imagen" name="imagen" accept="image/jpeg,image/png,image/webp,image/gif" />

    <label for="contenido">Contenido (admite HTML básico: &lt;p&gt;, &lt;h2&gt;, &lt;strong&gt;...)</label>
    <textarea id="contenido" name="contenido" rows="12" required><%= post ? post.contenido : '' %></textarea>

    <button type="submit"><%= post ? "Guardar cambios" : "Publicar artículo" %></button>
  </form>
</section>

<%- include('../partials/footer') %>
