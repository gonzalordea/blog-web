<%- include('../partials/header', { metaTitulo: (post ? "Editar artículo" : "Nuevo artículo") + " — Código al Día", metaNoIndex: true }) %>

<section class="form-caja">
  <h1><%= post ? "Editar artículo" : "Nuevo artículo" %></h1>

  <% if (typeof error !== "undefined" && error) { %>
    <p class="mensaje-error"><%= error %></p>
  <% } %>

  <form action="<%= post ? '/admin/posts/' + post.id + '/editar' : '/admin/posts/nuevo' %>" method="POST" enctype="multipart/form-data" class="formulario">
    <label for="titulo">Título</label>
    <input type="text" id="titulo" name="titulo" required value="<%= post ? post.titulo : '' %>" />

    <label for="slug">URL del artículo (opcional)</label>
    <input type="text" id="slug" name="slug" value="<%= post && post.slug ? post.slug : '' %>" placeholder="Se genera automáticamente a partir del título si lo dejas en blanco" />
    <% if (post && post.slug) { %>
      <p class="form-imagen-nota">URL actual: /post/<%= post.slug %>. Si la cambias, el enlace anterior deja de funcionar (a diferencia de un enlace antiguo /post/&lt;id&gt;, que sí redirige solo) — cámbiala solo si aún no la has compartido ni indexado.</p>
    <% } %>

    <label for="resumen">Resumen (aparece en la portada)</label>
    <textarea id="resumen" name="resumen" rows="2" required><%= post ? post.resumen : '' %></textarea>

    <label for="meta_descripcion">Meta descripción para buscadores (opcional, 150-160 caracteres recomendado)</label>
    <textarea id="meta_descripcion" name="meta_descripcion" rows="2" maxlength="300"><%= post && post.meta_descripcion ? post.meta_descripcion : '' %></textarea>
    <p class="form-imagen-nota">Si la dejas en blanco, se usa el resumen de arriba (que puede ser más largo de lo que Google suele mostrar sin cortar).</p>

    <label for="categoria_id">Categoría</label>
    <select id="categoria_id" name="categoria_id">
      <option value="">Sin categoría</option>
      <% categorias.forEach(function(categoria) { %>
        <option value="<%= categoria.id %>" <%= post && post.categoria_id === categoria.id ? 'selected' : '' %>>
          <%= categoria.nombre %>
        </option>
      <% }); %>
    </select>

    <label for="estado">Estado</label>
    <select id="estado" name="estado">
      <option value="borrador" <%= (!post || post.estado !== "publicado") ? "selected" : "" %>>Borrador (solo lo ves tú desde el panel)</option>
      <option value="publicado" <%= (post && post.estado === "publicado") ? "selected" : "" %>>Publicado (visible en la web)</option>
    </select>

    <label for="imagen">Imagen del artículo (opcional, JPG/PNG/WEBP/GIF, máx. 5 MB)</label>
    <% if (post && post.imagen) { %>
      <img src="<%= post.imagen %>" alt="Imagen actual" class="form-imagen-actual" />
      <p class="form-imagen-nota">Sube un archivo solo si quieres reemplazar esta imagen.</p>
    <% } %>
    <input type="file" id="imagen" name="imagen" accept="image/jpeg,image/png,image/webp,image/gif" />

    <label for="contenido">Contenido (admite HTML básico: &lt;p&gt;, &lt;h2&gt;, &lt;strong&gt;...)</label>
    <textarea id="contenido" name="contenido" rows="12" required><%= post ? post.contenido : '' %></textarea>

    <button type="submit"><%= post ? "Guardar cambios" : "Guardar artículo" %></button>
  </form>
</section>

<%- include('../partials/footer') %>
