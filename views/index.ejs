<%
  const hayCategoria = typeof categoriaActual !== "undefined" && categoriaActual;
  const tituloIndex = (typeof busqueda !== "undefined" && busqueda)
    ? `Resultados para "${busqueda}" — Blog Dev`
    : hayCategoria
      ? `${categoriaActual.nombre} — Blog Dev`
      : "Blog Dev — Notas y recursos de desarrollo web";
  const descripcionIndex = hayCategoria
    ? `Artículos de la categoría ${categoriaActual.nombre} en Blog Dev: guías prácticas, opiniones y recomendaciones sobre desarrollo web.`
    : "Artículos, cursos, herramientas y recursos para quien está aprendiendo desarrollo web: guías prácticas, opiniones y recomendaciones.";
  const canonicaIndex = hayCategoria ? `/categoria/${categoriaActual.slug}` : "/";
%>
<%- include('partials/header', {
  metaTitulo: tituloIndex,
  metaDescripcion: descripcionIndex,
  metaCanonica: canonicaIndex,
  conBarraLateral: true
}) %>

<div class="col-principal">

<section class="hero">
  <% if (hayCategoria) { %>
    <p class="hero-etiqueta" style="<%= categoriaActual.color ? `color: ${categoriaActual.color};` : '' %>">Categoría</p>
    <h1><%= categoriaActual.nombre %></h1>
  <% } else { %>
    <p class="hero-etiqueta">Notas y recursos de desarrollo web</p>
    <h1>Aprendiendo a construir cosas, un artículo a la vez.</h1>
  <% } %>
</section>

<% if (typeof destacado !== "undefined" && destacado) { %>
  <a href="/post/<%= destacado.id %>" class="destacado-post">
    <% if (destacado.imagen) { %>
      <img src="<%= destacado.imagen %>" alt="<%= destacado.titulo %>" class="destacado-post-img" />
    <% } else { %>
      <div class="destacado-post-img fila-post-img-placeholder" aria-hidden="true">
        <span><%= destacado.titulo.trim().charAt(0).toUpperCase() %></span>
      </div>
    <% } %>
    <div class="destacado-post-contenido">
      <p class="destacado-post-etiqueta">Artículo destacado</p>
      <% if (destacado.categoria_nombre) { %>
        <p class="fila-post-meta" style="<%= destacado.categoria_color ? `color: ${destacado.categoria_color};` : '' %>">
          <%= destacado.categoria_nombre %>
        </p>
      <% } %>
      <h2><%= destacado.titulo %></h2>
      <p class="fila-post-resumen"><%= destacado.resumen %></p>
      <span class="leer-mas">Leer artículo</span>
    </div>
  </a>
<% } %>

<% if (categorias.length > 0) { %>
  <nav class="tabs-categorias">
    <a href="/" class="<%= !categoriaSeleccionada ? 'tab-activa' : '' %>">Todo</a>
    <% categorias.forEach(function(categoria) { %>
      <a
        href="/categoria/<%= categoria.slug %>"
        class="<%= categoriaSeleccionada === categoria.id ? 'tab-activa' : '' %>"
        <% if (categoria.color) { %>style="--color-cat: <%= categoria.color %>;"<% } %>
      >
        <%= categoria.nombre %>
      </a>
    <% }); %>
  </nav>
<% } %>

<% if (typeof busqueda !== "undefined" && busqueda) { %>
  <p class="resultado-busqueda">
    <%= posts.length %> resultado<%= posts.length === 1 ? '' : 's' %> para "<strong><%= busqueda %></strong>"
    <a href="/" class="limpiar-busqueda">Borrar búsqueda</a>
  </p>
<% } %>

<section class="lista-posts">
  <% if (posts.length === 0) { %>
    <p class="vacio">
      <% if (typeof busqueda !== "undefined" && busqueda) { %>
        No se encontraron artículos que coincidan con tu búsqueda.
      <% } else { %>
        Todavía no hay artículos publicados. Vuelve pronto.
      <% } %>
    </p>
  <% } %>

  <% posts.forEach(function(post) { %>
    <article class="fila-post">
      <a href="/post/<%= post.id %>" class="fila-post-img-envoltorio">
        <% if (post.imagen) { %>
          <img src="<%= post.imagen %>" alt="<%= post.titulo %>" class="fila-post-img" />
        <% } else { %>
          <div class="fila-post-img fila-post-img-placeholder" aria-hidden="true">
            <span><%= post.titulo.trim().charAt(0).toUpperCase() %></span>
          </div>
        <% } %>
      </a>
      <div class="fila-post-contenido">
        <p class="fila-post-meta" style="<%= post.categoria_color ? `color: ${post.categoria_color};` : '' %>">
          <% if (post.categoria_nombre) { %><%= post.categoria_nombre %><% } else { %>Sin categoría<% } %>
        </p>
        <h2><a href="/post/<%= post.id %>"><%= post.titulo %></a></h2>
        <p class="fila-post-resumen"><%= post.resumen %></p>
        <a href="/post/<%= post.id %>" class="leer-mas">Leer artículo</a>
      </div>
    </article>
  <% }); %>
</section>

<% if (totalPaginas > 1) { %>
  <nav class="paginacion" aria-label="Paginacion">
    <% if (urlPaginaAnterior) { %>
      <a href="<%= urlPaginaAnterior %>" class="boton boton-secundario">&larr; Anteriores</a>
    <% } else { %>
      <span></span>
    <% } %>
    <span class="paginacion-actual">Pagina <%= paginaActual %> de <%= totalPaginas %></span>
    <% if (urlPaginaSiguiente) { %>
      <a href="<%= urlPaginaSiguiente %>" class="boton boton-secundario">Siguientes &rarr;</a>
    <% } else { %>
      <span></span>
    <% } %>
  </nav>
<% } %>

</div>

<aside class="barra-lateral">
  <div class="widget-lateral">
    <h2>Blog Dev</h2>
    <p>Notas y recursos sobre desarrollo web: cursos, herramientas y opiniones, pensados para quien esta aprendiendo a programar.</p>
  </div>

  <% if (categorias.length > 0) { %>
    <div class="widget-lateral">
      <h2>Categorias</h2>
      <ul class="widget-lista">
        <% categorias.forEach(function(categoria) { %>
          <li>
            <a
              href="/categoria/<%= categoria.slug %>"
              <% if (categoria.color) { %>style="--color-cat: <%= categoria.color %>;"<% } %>
            ><%= categoria.nombre %></a>
          </li>
        <% }); %>
      </ul>
    </div>
  <% } %>
</aside>

<%- include('partials/footer') %>
