<%
  const resumenLimpio = post.resumen.replace(/\s+/g, " ").trim();
  const fechaIso = post.fecha_creacion.replace(" ", "T");
  // fecha_actualizacion es NULL hasta que alguien edita el articulo desde el
  // panel admin, y solo la mostramos si de verdad aporta algo (fecha distinta
  // a la de creacion), para no decir "actualizado" en articulos que no se han
  // tocado desde que se publicaron.
  const fechaActualizacionIso = post.fecha_actualizacion
    ? post.fecha_actualizacion.replace(" ", "T")
    : null;
  const mostrarFechaActualizacion =
    fechaActualizacionIso && post.fecha_actualizacion.slice(0, 10) !== post.fecha_creacion.slice(0, 10);
  const jsonLd = {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: post.titulo,
    description: resumenLimpio,
    datePublished: fechaIso,
    dateModified: fechaActualizacionIso || fechaIso,
    mainEntityOfPage: urlBase + "/post/" + post.id,
    author: { "@type": "Organization", name: "Blog Dev" },
    publisher: { "@type": "Organization", name: "Blog Dev" },
  };
  if (post.imagen) {
    jsonLd.image = post.imagen.startsWith("http") ? post.imagen : urlBase + post.imagen;
  }

  // Miga de pan tambien como datos estructurados, para que Google pueda
  // mostrarla en los resultados de busqueda en vez de la URL pelada.
  const migasItems = [{ "@type": "ListItem", position: 1, name: "Inicio", item: urlBase + "/" }];
  if (post.categoria_nombre) {
    migasItems.push({
      "@type": "ListItem",
      position: 2,
      name: post.categoria_nombre,
      item: urlBase + "/?categoria=" + post.categoria_id,
    });
  }
  migasItems.push({
    "@type": "ListItem",
    position: migasItems.length + 1,
    name: post.titulo,
    item: urlBase + "/post/" + post.id,
  });
  const breadcrumbJsonLd = {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: migasItems,
  };
%>
<%- include('partials/header', {
  metaTitulo: post.titulo + " — Blog Dev",
  metaDescripcion: resumenLimpio,
  metaCanonica: "/post/" + post.id,
  metaImagen: post.imagen,
  metaTipoOg: "article",
  conBarraLateral: true
}) %>

<script type="application/ld+json"><%- JSON.stringify(jsonLd) %></script>
<script type="application/ld+json"><%- JSON.stringify(breadcrumbJsonLd) %></script>

<div class="col-principal">

<article class="post-detalle">
  <nav class="migas" aria-label="Miga de pan">
    <a href="/">Inicio</a>
    <% if (post.categoria_nombre) { %>
      <span class="migas-sep">/</span>
      <a href="/?categoria=<%= post.categoria_id %>"><%= post.categoria_nombre %></a>
    <% } %>
    <span class="migas-sep">/</span>
    <span class="migas-actual"><%= post.titulo %></span>
  </nav>

  <div class="acciones-articulo">
    <button
      type="button"
      class="boton-compartir"
      data-url="<%= urlBase %>/post/<%= post.id %>"
      onclick="
        navigator.clipboard.writeText(this.dataset.url).then(() => {
          const textoOriginal = this.textContent;
          this.textContent = 'Enlace copiado';
          setTimeout(() => { this.textContent = textoOriginal; }, 2000);
        });
      "
    >Copiar enlace</button>

    <button type="button" id="boton-modo-lectura" class="boton-compartir">Modo lectura</button>
  </div>

  <% if (post.categoria_nombre) { %>
    <p class="fila-post-meta"><%= post.categoria_nombre %></p>
  <% } %>
  <h1><%= post.titulo %></h1>
  <p class="fecha">
    Publicado el <%= post.fecha_creacion %>
    <% if (mostrarFechaActualizacion) { %>
      <span class="fecha-actualizado">&middot; Actualizado el <%= post.fecha_actualizacion %></span>
    <% } %>
    &middot; <%= tiempoLectura %> min de lectura
  </p>

  <nav class="indice-articulo" id="indice-articulo" hidden>
    <p class="indice-titulo">Indice</p>
    <ol class="indice-lista"></ol>
  </nav>

  <% if (post.imagen) { %>
    <img src="<%= post.imagen %>" alt="<%= post.titulo %>" class="post-detalle-img" />
  <% } %>

  <div class="post-detalle-contenido">
    <%- post.contenido %>
  </div>
</article>

<script>
  (function () {
    var contenedorIndice = document.getElementById("indice-articulo");
    var lista = contenedorIndice ? contenedorIndice.querySelector(".indice-lista") : null;
    var titulos = document.querySelectorAll(".post-detalle-contenido h2");

    // Con menos de 2 apartados, un indice no aporta nada: se queda oculto.
    if (!contenedorIndice || !lista || titulos.length < 2) return;

    var usados = {};
    titulos.forEach(function (titulo) {
      var base = titulo.textContent
        .toLowerCase()
        .normalize("NFD").replace(/[\u0300-\u036f]/g, "")
        .replace(/[^a-z0-9]+/g, "-")
        .replace(/(^-|-$)/g, "");
      var slug = base || "seccion";

      if (usados[slug] != null) {
        usados[slug] += 1;
        slug = slug + "-" + usados[slug];
      } else {
        usados[slug] = 0;
      }
      titulo.id = slug;

      var item = document.createElement("li");
      var enlace = document.createElement("a");
      enlace.href = "#" + slug;
      enlace.textContent = titulo.textContent;
      item.appendChild(enlace);
      lista.appendChild(item);
    });

    contenedorIndice.hidden = false;
  })();
</script>

<script>
  (function () {
    // "Modo lectura": oculta cabecera, barra lateral, pie y comentarios para
    // dejar solo el articulo. Se recuerda la preferencia entre visitas.
    var boton = document.getElementById("boton-modo-lectura");
    if (!boton) return;

    function actualizarTexto() {
      boton.textContent = document.body.classList.contains("modo-lectura")
        ? "Salir del modo lectura"
        : "Modo lectura";
    }

    try {
      if (localStorage.getItem("modoLectura") === "activado") {
        document.body.classList.add("modo-lectura");
      }
    } catch (e) {
      // Si el navegador bloquea localStorage (modo privado, etc.), el boton
      // sigue funcionando, solo que no recuerda la preferencia.
    }
    actualizarTexto();

    boton.addEventListener("click", function () {
      document.body.classList.toggle("modo-lectura");
      actualizarTexto();
      try {
        localStorage.setItem(
          "modoLectura",
          document.body.classList.contains("modo-lectura") ? "activado" : "desactivado"
        );
      } catch (e) {}
    });
  })();
</script>

<% if (relacionados && relacionados.length > 0) { %>
  <section class="relacionados">
    <h2>Tambien te puede interesar</h2>
    <div class="relacionados-lista">
      <% relacionados.forEach(function(rel) { %>
        <a href="/post/<%= rel.id %>" class="relacionado-item">
          <% if (rel.imagen) { %>
            <img src="<%= rel.imagen %>" alt="" class="relacionado-img" />
          <% } else { %>
            <div class="relacionado-img fila-post-img-placeholder" aria-hidden="true">
              <span><%= rel.titulo.trim().charAt(0).toUpperCase() %></span>
            </div>
          <% } %>
          <span class="relacionado-titulo"><%= rel.titulo %></span>
        </a>
      <% }); %>
    </div>
  </section>
<% } %>

<section class="comentarios" id="comentarios">
  <h2>Comentarios <% if (comentarios.length) { %>(<%= comentarios.length %>)<% } %></h2>

  <% if (comentarios.length === 0) { %>
    <p class="vacio">Todavía no hay comentarios. ¡Sé el primero en opinar!</p>
  <% } else { %>
    <ul class="lista-comentarios">
      <% comentarios.forEach(function(comentario) { %>
        <li class="comentario">
          <div class="comentario-cabecera">
            <span class="comentario-nombre"><%= comentario.nombre %></span>
            <span class="comentario-fecha"><%= comentario.fecha_creacion %></span>
          </div>
          <p class="comentario-contenido"><%= comentario.contenido %></p>
        </li>
      <% }); %>
    </ul>
  <% } %>

  <h3>Deja tu comentario</h3>
  <% if (typeof errorComentario !== "undefined" && errorComentario) { %>
    <p class="mensaje-error"><%= errorComentario %></p>
  <% } %>
  <form action="/post/<%= post.id %>/comentarios" method="POST" class="formulario formulario-comentario">
    <label for="nombre">Nombre</label>
    <input type="text" id="nombre" name="nombre" required maxlength="80" />

    <label for="contenido-comentario">Comentario</label>
    <textarea id="contenido-comentario" name="contenido" rows="4" required maxlength="2000"></textarea>

    <button type="submit">Publicar comentario</button>
  </form>
</section>

</div>

<aside class="barra-lateral">
  <div class="widget-lateral">
    <h2>Blog Dev</h2>
    <p>Notas y recursos sobre desarrollo web: cursos, herramientas y opiniones, pensados para quien esta aprendiendo a programar.</p>
  </div>

  <% if (categorias.length > 0) { %>
    <div class="widget-lateral">
      <h2>Categorias</h2>
      <ul class="widget-lista">
        <% categorias.forEach(function(categoria) { %>
          <li><a href="/?categoria=<%= categoria.id %>"><%= categoria.nombre %></a></li>
        <% }); %>
      </ul>
    </div>
  <% } %>

  <% if (ultimosPosts.length > 0) { %>
    <div class="widget-lateral">
      <h2>Ultimos articulos</h2>
      <ul class="widget-lista">
        <% ultimosPosts.forEach(function(p) { %>
          <li><a href="/post/<%= p.id %>"><%= p.titulo %></a></li>
        <% }); %>
      </ul>
    </div>
  <% } %>
</aside>

<%- include('partials/footer') %>
