  </main>
  <footer class="pie">
    <p>&copy; <%= new Date().getFullYear() %> Código al Día — Notas y recursos de desarrollo web</p>
    <p class="pie-legal"><a href="/privacidad">Privacidad</a> &middot; <a href="/cookies">Cookies</a> &middot; <a href="/contacto">Contacto</a></p>
  </footer>

  <button type="button" id="boton-arriba" class="boton-arriba" aria-label="Volver arriba" hidden>&uarr;</button>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/components/prism-core.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/plugins/autoloader/prism-autoloader.min.js"></script>
  <script>
    // Los bloques de codigo que no indican lenguaje (la mayoria de nuestros
    // articulos son comandos de terminal) se tratan como bash por defecto,
    // para que al menos salgan resaltados en vez de en texto plano.
    document.querySelectorAll("pre code:not([class*=\"language-\"])").forEach(function (bloque) {
      bloque.classList.add("language-bash");
    });
  </script>

  <script>
    // Boton flotante "volver arriba": aparece solo tras bajar un poco,
    // para no estorbar en paginas cortas.
    var botonArriba = document.getElementById("boton-arriba");
    if (botonArriba) {
      window.addEventListener("scroll", function () {
        botonArriba.hidden = window.scrollY < 400;
      });
      botonArriba.addEventListener("click", function () {
        window.scrollTo({ top: 0, behavior: "smooth" });
      });
    }
  </script>
</body>
</html>
