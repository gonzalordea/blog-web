<!-- views/partials/header.ejs -->
<%
  // Cada vista puede pasar sus propios metaTitulo/metaDescripcion/etc. al
  // incluir este partial. Si no los pasa, se usan estos valores por defecto
  // (los de la portada).
  const _titulo = typeof metaTitulo !== "undefined" ? metaTitulo : "Código al Día — Notas y recursos de desarrollo web";
  const _descripcion = typeof metaDescripcion !== "undefined" ? metaDescripcion : "Artículos, cursos, herramientas y recursos para quien está aprendiendo desarrollo web.";
  const _canonica = urlBase + (typeof metaCanonica !== "undefined" ? metaCanonica : "/");
  const _tipoOg = typeof metaTipoOg !== "undefined" ? metaTipoOg : "website";
  // Si el articulo no tiene imagen propia, usamos una imagen de marca por
  // defecto (public/og-default.png) para que compartir un enlace en
  // WhatsApp/Twitter/etc. siempre muestre una vista previa, nunca un hueco
  // en blanco.
  const _imagen = typeof metaImagen !== "undefined" && metaImagen
    ? (metaImagen.startsWith("http") ? metaImagen : urlBase + metaImagen)
    : urlBase + "/og-default.png";
  const _noIndex = typeof metaNoIndex !== "undefined" && metaNoIndex;
%>
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <script>
    // Aplica el tema guardado (si el visitante eligio uno a mano) antes de
    // pintar la pagina, para no dar un parpadeo del tema por defecto seguido
    // del tema real. Si no hay nada guardado, no se toca nada: manda
    // prefers-color-scheme, como hasta ahora.
    (function () {
      try {
        var tema = localStorage.getItem("tema");
        if (tema === "light" || tema === "dark") {
          document.documentElement.setAttribute("data-theme", tema);
        }
      } catch (e) {}
    })();
  </script>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= _titulo %></title>
  <meta name="description" content="<%= _descripcion %>" />
  <link rel="canonical" href="<%= _canonica %>" />

  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" type="image/png" sizes="32x32" href="/icons/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/icons/favicon-16x16.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/icons/apple-touch-icon.png" />
  <link rel="alternate" type="application/rss+xml" title="Código al Día" href="/rss.xml" />
  <% if (_noIndex) { %>
    <meta name="robots" content="noindex, nofollow" />
  <% } %>

  <meta property="og:type" content="<%= _tipoOg %>" />
  <meta property="og:title" content="<%= _titulo %>" />
  <meta property="og:description" content="<%= _descripcion %>" />
  <meta property="og:url" content="<%= _canonica %>" />
  <meta property="og:site_name" content="Código al Día" />
  <meta property="og:image" content="<%= _imagen %>" />
  <meta property="og:locale" content="es_ES" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="<%= _titulo %>" />
  <meta name="twitter:description" content="<%= _descripcion %>" />
  <meta name="twitter:image" content="<%= _imagen %>" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,600;1,9..144,500&family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/themes/prism-tomorrow.min.css" />
  <link rel="stylesheet" href="/css/style.css" />

  <% if (cfAnalyticsToken) { %>
    <!-- Cloudflare Web Analytics: gratis, sin cookies, sin datos personales -->
    <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "<%= cfAnalyticsToken %>"}'></script>
  <% } %>
</head>
<body>
  <header class="cabecera">
    <a href="/" class="logo">código<span class="logo-punto">al</span>día</a>
    <form action="/" method="GET" class="barra-busqueda" role="search">
      <svg class="icono-busqueda" width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2" />
        <line x1="21" y1="21" x2="16.65" y2="16.65" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
      </svg>
      <input
        type="search"
        name="q"
        placeholder="Buscar artículos..."
        value="<%= typeof busqueda !== 'undefined' ? busqueda : '' %>"
        aria-label="Buscar artículos"
      />
    </form>
    <button type="button" id="boton-tema" class="boton-tema" aria-label="Cambiar entre modo claro y oscuro">
      <svg class="icono-sol" width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <circle cx="12" cy="12" r="4.5" stroke="currentColor" stroke-width="2" />
        <path d="M12 2.5V5M12 19V21.5M4.2 4.2L6 6M18 18L19.8 19.8M2.5 12H5M19 12H21.5M4.2 19.8L6 18M18 6L19.8 4.2" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
      </svg>
      <svg class="icono-luna" width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M20 14.5A8.5 8.5 0 1 1 9.5 4a7 7 0 0 0 10.5 10.5Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
      </svg>
    </button>
    <nav>
      <a href="/json">Herramientas<span class="pastilla-nueva">Nuevo</span></a>
      <a href="/sobre">Sobre</a>
      <a href="/contacto">Contacto</a>
      <a href="/rss.xml">RSS</a>
      <% if (typeof sesionIniciada !== "undefined" && sesionIniciada) { %>
        <a href="/admin/dashboard">Panel admin</a>
        <form action="/admin/logout" method="POST" class="form-logout">
          <button type="submit">Cerrar sesión</button>
        </form>
      <% } %>
    </nav>
  </header>
  <script>
    // Alternar tema: si no hay eleccion guardada, el punto de partida es lo
    // que se este viendo ahora mismo (que ya depende de prefers-color-scheme
    // gracias al script del <head>), no siempre "claro".
    (function () {
      var boton = document.getElementById("boton-tema");
      if (!boton) return;

      boton.addEventListener("click", function () {
        var oscuroActivo = document.documentElement.getAttribute("data-theme") === "dark"
          || (
            document.documentElement.getAttribute("data-theme") !== "light"
            && window.matchMedia("(prefers-color-scheme: dark)").matches
          );
        var nuevoTema = oscuroActivo ? "light" : "dark";
        document.documentElement.setAttribute("data-theme", nuevoTema);
        try {
          localStorage.setItem("tema", nuevoTema);
        } catch (e) {}
      });
    })();
  </script>
  <main class="contenedor<%= (typeof conBarraLateral !== "undefined" && conBarraLateral) ? " contenedor--con-barra" : "" %><%= (typeof anchoAmplio !== "undefined" && anchoAmplio) ? " contenedor--ancho" : "" %>">
